{
  "name": "pharmacy-pos",
  "private": true,
  "version": "1.0.9",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win --ia32 --x64",
    "electron:publish": "vite build && electron-builder --win --ia32 --x64 --publish always"
  },
  "build": {
    "appId": "com.techi.pharmacypos",
    "productName": "Pharmacy POS",
    "artifactName": "Pharmacy-POS-Setup-${version}.${ext}",
    "electronVersion": "43.7.5",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.cjs",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Techiboy1",
        "repo": "pharmacy-pos",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "crypto-js": "^4.2.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.446.0",
    "node-machine-id": "^1.1.12",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.5",
    "electron": "43.7.5",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "wait-on": "^9.1.0"
  }
}
